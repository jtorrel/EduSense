# Base dédiée au service (pas la base ERP « auto »)
DATABASE_URL=mysql://avis:motdepasse@localhost:3306/edusense_avis

# URL publique, sans « / » final. En https, les cookies sont marqués « Secure ».
PUBLIC_BASE_URL=http://localhost:8080

# Client OAuth Google « Application Web » — URI de redirection : {PUBLIC_BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# Seuls les comptes de ce domaine peuvent se connecter
ALLOWED_DOMAIN=normandiewebschool.fr

# Superadmins, séparés par des virgules
SUPERADMINS=prenom.nom@normandiewebschool.fr

# Catégories proposées, séparées par des points-virgules
CATEGORIES=Cours;Intervenant;Organisation;Locaux et matériel;Vie étudiante;Autre

# Clé de chiffrement des cookies de session (au moins 32 caractères, à garder secrète).
# Générer : openssl rand -hex 32   — la changer déconnecte tout le monde.
SESSION_SECRET=

# Adresse d'écoute
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,sqlx=warn

# Connexion simulée, uniquement si compilé avec --features dev-login. Jamais en production.
# DEV_LOGIN=1
